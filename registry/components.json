{
  "$comment": "Fonte ÚNICA dos componentes do VForm. A IDE (catálogo, painel, autocompletar, dicionário, manual) e o runtime Python leem este arquivo. Para criar ou mudar um componente, edite aqui.",
  "version": 1,
  "commonProps": {
    "enabled": {
      "key": "enabled",
      "label": "Habilitado",
      "type": "boolean",
      "default": true
    },
    "visible": {
      "key": "visible",
      "label": "Visível",
      "type": "boolean",
      "default": true
    },
    "fontSize": {
      "key": "fontSize",
      "label": "Tamanho da fonte",
      "type": "number",
      "default": 12,
      "min": 6,
      "max": 72
    },
    "bold": {
      "key": "bold",
      "label": "Negrito",
      "type": "boolean",
      "default": false
    },
    "italic": {
      "key": "italic",
      "label": "Itálico",
      "type": "boolean",
      "default": false
    },
    "color": {
      "key": "color",
      "label": "Cor do texto",
      "type": "color",
      "default": ""
    },
    "background": {
      "key": "background",
      "label": "Cor de fundo",
      "type": "color",
      "default": ""
    },
    "tooltip": {
      "key": "tooltip",
      "label": "Dica (tooltip)",
      "type": "string",
      "default": ""
    }
  },
  "methods": {
    "add_item": {
      "detail": "add_item(item)",
      "doc": "Acrescenta um item ao final.",
      "insert": "add_item($0)"
    },
    "remove_item": {
      "detail": "remove_item(item)",
      "doc": "Remove o primeiro item igual a `item`.",
      "insert": "remove_item($0)"
    },
    "remove_at": {
      "detail": "remove_at(índice)",
      "doc": "Remove o item da posição `índice`.",
      "insert": "remove_at($0)"
    },
    "clear": {
      "detail": "clear()",
      "doc": "Limpa: remove todos os itens (listas e tabelas) ou esvazia o valor (campos).",
      "insert": "clear()"
    },
    "add_row": {
      "detail": "add_row(linha)",
      "doc": "Acrescenta uma linha (lista de valores).",
      "insert": "add_row($0)"
    },
    "show": {
      "detail": "show()",
      "doc": "Exibe o componente.",
      "insert": "show()"
    },
    "hide": {
      "detail": "hide()",
      "doc": "Oculta o componente (ele continua existindo, só some da tela).",
      "insert": "hide()"
    },
    "set_visible": {
      "detail": "set_visible(visível)",
      "doc": "Mostra (True) ou oculta (False).",
      "insert": "set_visible($0)"
    },
    "enable": {
      "detail": "enable()",
      "doc": "Habilita o componente.",
      "insert": "enable()"
    },
    "disable": {
      "detail": "disable()",
      "doc": "Desabilita o componente (fica cinza e não responde).",
      "insert": "disable()"
    },
    "set_enabled": {
      "detail": "set_enabled(habilitado)",
      "doc": "Habilita (True) ou desabilita (False).",
      "insert": "set_enabled($0)"
    },
    "focus": {
      "detail": "focus()",
      "doc": "Leva o foco do teclado para o componente.",
      "insert": "focus()"
    },
    "blur": {
      "detail": "blur()",
      "doc": "Tira o foco do teclado do componente.",
      "insert": "blur()"
    },
    "set_tooltip": {
      "detail": "set_tooltip(texto)",
      "doc": "Define a dica que aparece ao parar o mouse em cima.",
      "insert": "set_tooltip($0)"
    },
    "set_position": {
      "detail": "set_position(x, y)",
      "doc": "Muda a posição (px). Num painel com layout automático, quem manda na posição é o painel.",
      "insert": "set_position($0)"
    },
    "set_size": {
      "detail": "set_size(largura, altura)",
      "doc": "Muda o tamanho (px, mínimo 1).",
      "insert": "set_size($0)"
    },
    "reset": {
      "detail": "reset()",
      "doc": "Volta as propriedades do componente aos valores padrão (posição e tamanho não mudam).",
      "insert": "reset()"
    },
    "increment": {
      "detail": "increment(quanto=None)",
      "doc": "Soma ao valor (por padrão, o passo do componente), sem passar do máximo.",
      "insert": "increment()"
    },
    "decrement": {
      "detail": "decrement(quanto=None)",
      "doc": "Subtrai do valor (por padrão, o passo do componente), sem passar do mínimo.",
      "insert": "decrement()"
    },
    "set_range": {
      "detail": "set_range(mínimo, máximo)",
      "doc": "Define o menor e o maior valor aceitos; o valor atual é ajustado para caber.",
      "insert": "set_range($0)"
    },
    "toggle": {
      "detail": "toggle()",
      "doc": "Inverte o estado: ligado/desligado (interruptor) ou recolhido/expandido (Card e GroupBox).",
      "insert": "toggle()"
    },
    "turn_on": {
      "detail": "turn_on()",
      "doc": "Liga o interruptor.",
      "insert": "turn_on()"
    },
    "turn_off": {
      "detail": "turn_off()",
      "doc": "Desliga o interruptor.",
      "insert": "turn_off()"
    },
    "set_today": {
      "detail": "set_today()",
      "doc": "Coloca a data de hoje.",
      "insert": "set_today()"
    },
    "show_password": {
      "detail": "show_password()",
      "doc": "Mostra os caracteres da senha.",
      "insert": "show_password()"
    },
    "hide_password": {
      "detail": "hide_password()",
      "doc": "Volta a esconder os caracteres da senha.",
      "insert": "hide_password()"
    },
    "open": {
      "detail": "open()",
      "doc": "Abre o endereço do link no navegador (só http, https e mailto).",
      "insert": "open()"
    },
    "collapse": {
      "detail": "collapse()",
      "doc": "Recolhe: fica só o cabeçalho e o conteúdo some.",
      "insert": "collapse()"
    },
    "expand": {
      "detail": "expand()",
      "doc": "Expande de volta, mostrando o conteúdo.",
      "insert": "expand()"
    },
    "start_indeterminate": {
      "detail": "start_indeterminate()",
      "doc": "Liga a animação de \"trabalhando\", para quando não dá para saber quanto falta.",
      "insert": "start_indeterminate()"
    },
    "stop_indeterminate": {
      "detail": "stop_indeterminate()",
      "doc": "Desliga a animação e volta a mostrar o valor.",
      "insert": "stop_indeterminate()"
    }
  },
